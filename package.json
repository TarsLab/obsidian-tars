	"description": "Text generation based on tag suggestions, using DeepSeek, Claude, OpenAI, OpenRouter, SiliconFlow, Gemini, Qwen & more.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"format": "prettier --write src/",
		"smoke": "node esbuild.smoke.mjs"
	},
	"keywords": [],
	"author": "C Jack<https://github.com/ae86jack>",
	"license": "MIT",
	"dependencies": {
		"axios": "^1.20.0",
		"handlebars": "^4.7.9"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.56.0",
		"@eslint/js": "^9.39.5",
		"@google/generative-ai": "^0.21.0",
		"@types/node": "^22.15.17",
		"esbuild": "^0.25.8",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jose": "^5.2.4",
		"obsidian": "latest",
		"ollama": "^0.5.16",
		"openai": "^5.0.1",
		"prettier": "^3.3.3",
		"tslib": "^2.4.0",
